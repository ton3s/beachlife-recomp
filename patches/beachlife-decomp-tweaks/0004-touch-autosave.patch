diff --git a/src/tweak_autosave.cpp b/src/tweak_autosave.cpp
new file mode 100644
--- /dev/null
+++ b/src/tweak_autosave.cpp
@@ -0,0 +1,35 @@
+#include "startup_game_file.h"
+#include "startup_screen_manager.h"
+#include "startup_screen_request.h"
+#include "window_activation.h"
+
+#include <stdio.h>
+
+// Touch support, not in the original game: iOS can close a backgrounded app without
+// warning, so the host asks for this save. It has its own slot, shown in the load list,
+// and only replaces the previous autosave once the new one is completely written.
+void WriteGameSave(ScreenRequestGamePrefix* game, const char* path);
+extern "C" int beachlife_compat_replace_user_file(const char* from, const char* to);
+
+static const int autosave_slot = 9999;
+
+static int autosave()
+{
+    // Mode 4 is the plain world view, where the player's own Save button works.
+    if (!screen_manager || !window_deactivation_state || !screen_request_game ||
+        screen_manager->mode != 4)
+        return 0;
+    // The world must be running, with no change to another game state on its way.
+    const ControllerSelectionState& state = screen_request_game->controller_selection;
+    if (state.active != state.first_controller || state.pending != state.active)
+        return 0;
+    char temporary[128];
+    char final_path[128];
+    sprintf(temporary, "%s/autosave.tmp", startup_save_directory);
+    sprintf(final_path, "%s/save%d.dat", startup_save_directory, autosave_slot);
+    WriteGameSave(screen_request_game, temporary);
+    return beachlife_compat_replace_user_file(temporary, final_path);
+}
+
+extern "C" void beachlife_touch_register_autosave(int (*)(void));
+static const int autosave_registered = (beachlife_touch_register_autosave(autosave), 0);
