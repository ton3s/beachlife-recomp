@@ -9,6 +9,33 @@
 #include <bit>
 #include <stdio.h>
 #include <time.h>
+
+// Touch autosave: the original SaveGame body, shared so an autosave writes the same file.
+void WriteGameSave(ScreenRequestGamePrefix* game, const char* path)
+{
+    GameFileReader* file = new GameFileReader(1, path);
+    file->Unknown3c(startup_save_signature);
+    file->Unknown30("Version", std::bit_cast<unsigned int>(startup_save_version));
+    time_t timestamp;
+    time(&timestamp);
+    file->Unknown28("Save time", static_cast<unsigned int>(timestamp));
+    file->Unknown28("Scenario number", game->scenario_a0);
+    file->Unknown28("GetGameDay", window_deactivation_state->day_15c);
+    file->Unknown30("GetGameDayTime", std::bit_cast<unsigned int>(window_deactivation_state->render_value_160));
+    file->Unknown30("PlayerCash", std::bit_cast<unsigned int>(window_deactivation_state->economy_1c->value_80));
+    file->Unknown28("NumGuests", window_deactivation_state->guests_43c);
+    char title[128];
+    if (game->byte_a4)
+    {
+        sprintf(title, "MAINSS_SANDBOX%d_TITLE", game->scenario_a0 + 1);
+        file->Unknown38("ScenarioTitle", title);
+    }
+    else
+        file->Unknown38("ScenarioTitle", window_deactivation_state->scenario_title_73c);
+    file->Unknown34("SandBoxMode", game->byte_a4);
+    window_deactivation_state->SaveState(file);
+    delete file;
+}
 
